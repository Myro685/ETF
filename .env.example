# Server only. Copy to ignored .env.local; never use a VITE_ prefix for secrets.
GUIDE_ENABLED=false
# Evaluation demo: server accepts only PRIVACY_CONTACT_EMAIL, never visitor emails.
GUIDE_DEMO_MODE=true
APP_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# gmail (selected) or resend (alternative); keys below are server-only.
MAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
RESEND_API_KEY=
GUIDE_FROM_EMAIL=
# After deployment: https://YOUR_HOST/guides/pruvodce-etf-2026-10-14.pdf
GUIDE_DOWNLOAD_URL=
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_POLICY_URL=
PRIVACY_NOTICE_VERSION=
